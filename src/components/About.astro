---
import { techStack } from '../data/content';
import { t, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<section id="about" class="border-b border-line bg-white">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <h2 class="text-3xl font-extrabold text-ink">{t(lang, 'about.title')}</h2>

    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-ink sm:text-xl">
      {t(lang, 'about.body1')}
    </p>

    <div class="mt-6 max-w-3xl border-l-4 border-royal bg-cloud px-5 py-4">
      <p class="leading-relaxed text-graphite">{t(lang, 'about.body2')}</p>
    </div>

    <div class="mt-12">
      <h3 class="text-sm font-bold uppercase tracking-wide text-graphite">
        {t(lang, 'about.stack')}
      </h3>
      <dl class="mt-4 border-t border-line">
        {
          techStack[lang].map((group) => (
            <div class="grid gap-2 border-b border-line py-4 sm:grid-cols-[170px_1fr] sm:items-start">
              <dt class="text-sm font-bold text-ink sm:pt-1.5">{group.label}</dt>
              <dd class="flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <span class="border border-line bg-cloud px-3 py-1 text-sm font-medium text-ink">
                    {item}
                  </span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

---
import { techStack } from '../data/content';
import { t, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const facts = [
  { label: t(lang, 'about.role'), value: t(lang, 'about.roleValue') },
  { label: t(lang, 'about.location'), value: t(lang, 'about.locationValue') },
  { label: t(lang, 'about.languages'), value: t(lang, 'about.languagesValue') },
  { label: t(lang, 'about.focus'), value: t(lang, 'about.focusValue') },
];
---

<section id="about" class="border-b border-line bg-white">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <h2 class="text-3xl font-extrabold text-ink">{t(lang, 'about.title')}</h2>

    <div class="mt-8 grid gap-10 md:grid-cols-3">
      <div class="md:col-span-2">
        <p class="leading-relaxed text-graphite">{t(lang, 'about.body1')}</p>
        <div class="mt-6 border-l-4 border-royal bg-cloud p-5">
          <p class="leading-relaxed text-ink">{t(lang, 'about.body2')}</p>
        </div>
      </div>

      <aside class="md:col-span-1">
        <div class="border border-line bg-cloud p-6">
          <h3 class="text-sm font-bold uppercase tracking-wide text-graphite">
            {t(lang, 'about.facts')}
          </h3>
          <dl class="mt-4 space-y-4">
            {
              facts.map((fact) => (
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-wide text-graphite">
                    {fact.label}
                  </dt>
                  <dd class="mt-1 text-sm font-medium text-ink">{fact.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </aside>
    </div>

    <h3 class="mb-6 mt-14 text-lg font-bold text-ink">{t(lang, 'about.stack')}</h3>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        techStack[lang].map((group) => (
          <div>
            <h4 class="mb-3 border-b border-line pb-2 text-sm font-bold uppercase tracking-wide text-graphite">
              {group.label}
            </h4>
            <ul class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="border border-line bg-cloud px-3 py-1.5 text-sm font-medium text-ink">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

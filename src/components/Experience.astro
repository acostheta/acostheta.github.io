---
import { experience } from '../data/content';
import { t, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const jobs = experience[lang];
---

<section id="experience" class="border-b border-line bg-white">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <h2 class="text-3xl font-extrabold text-ink">{t(lang, 'experience.title')}</h2>

    <ol class="mt-10 max-w-3xl">
      {
        jobs.map((job, i) => (
          <li class="grid grid-cols-[auto_1fr] gap-4">
            <div class="flex flex-col items-center">
              <span class="mt-1.5 h-3 w-3 shrink-0 rounded-full bg-royal" />
              {i < jobs.length - 1 && <span class="mt-1 w-0.5 grow bg-line" />}
            </div>
            <div class="pb-8">
              <span class="inline-block border border-line bg-cloud px-2 py-0.5 text-xs font-semibold tracking-wide text-graphite">
                {job.period}
              </span>
              <h3 class="mt-2 text-lg font-bold text-ink">{job.role}</h3>
              <p class="text-sm text-graphite">{job.company}</p>
              <ul class="mt-3 space-y-1.5">
                {job.bullets.map((b) => (
                  <li class="flex gap-2 text-sm leading-relaxed text-graphite">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-royal" />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

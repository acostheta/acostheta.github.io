---
import Socials from './Socials.astro';
import { t, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const FORM_ENDPOINT = 'https://formspree.io/f/xvzenarj';
const EMAIL = 'acostheta.dev@gmail.com';

const fieldClass =
  'w-full border border-white/40 bg-transparent px-4 py-3 text-white placeholder-white/60 transition-colors focus:border-white focus:outline-none';
---

<section id="contact" class="bg-royal text-white">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <h2 class="text-3xl font-extrabold">{t(lang, 'contact.title')}</h2>
    <p class="mt-3 text-white/90">{t(lang, 'contact.pitch')}</p>

    <div class="mt-8 grid gap-10 md:grid-cols-2">
      <form
        id="contact-form"
        action={FORM_ENDPOINT}
        method="POST"
        class="space-y-4"
        data-msg-sending={t(lang, 'contact.sending')}
        data-msg-sent={t(lang, 'contact.sent')}
        data-msg-error={t(lang, 'contact.error')}
      >
        <div>
          <label for="name" class="sr-only">{t(lang, 'contact.name')}</label>
          <input
            id="name"
            type="text"
            name="name"
            placeholder={t(lang, 'contact.name')}
            required
            class={fieldClass}
          />
        </div>
        <div>
          <label for="email" class="sr-only">{t(lang, 'contact.email')}</label>
          <input
            id="email"
            type="email"
            name="email"
            placeholder={t(lang, 'contact.email')}
            required
            class={fieldClass}
          />
        </div>
        <div>
          <label for="message" class="sr-only">{t(lang, 'contact.message')}</label>
          <textarea
            id="message"
            name="message"
            rows="4"
            placeholder={t(lang, 'contact.message')}
            required
            class={fieldClass}
          ></textarea>
        </div>
        <button
          type="submit"
          class="border border-white bg-ink px-8 py-3 text-sm font-bold uppercase tracking-widest text-white transition-colors hover:bg-white hover:text-ink"
        >
          {t(lang, 'contact.send')}
        </button>
        <p id="form-status" class="min-h-5 text-sm font-semibold text-white" aria-live="polite"></p>
      </form>

      <div class="flex flex-col">
        <h3 class="mb-4 font-bold">{t(lang, 'contact.social')}</h3>
        <Socials />

        <h3 class="mb-2 mt-8 font-bold">{t(lang, 'contact.email.me')}</h3>
        <a href={`mailto:${EMAIL}`} class="text-white underline underline-offset-4 hover:text-ink">
          {EMAIL}
        </a>

        <p class="mt-8 text-sm text-white/70">{t(lang, 'contact.location')}</p>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form');
  if (form) {
    const status = document.getElementById('form-status');
    const button = form.querySelector('button[type="submit"]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      status.textContent = form.dataset.msgSending || '';
      if (button) button.disabled = true;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          status.textContent = form.dataset.msgSent || 'OK';
          form.reset();
        } else {
          status.textContent = form.dataset.msgError || 'Error';
        }
      } catch {
        status.textContent = form.dataset.msgError || 'Error';
      } finally {
        if (button) button.disabled = false;
      }
    });
  }
</script>

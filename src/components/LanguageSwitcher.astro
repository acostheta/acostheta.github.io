---
import type { Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const other = lang === 'es' ? 'en' : 'es';
// El español vive en la raíz ("/") y el inglés en "/en/".
const href = other === 'es' ? '/' : '/en/';
const label = other === 'es' ? 'ES' : 'EN';
const srLabel = other === 'es' ? 'Cambiar a español' : 'Switch to English';
---

<a
  href={href}
  class="ml-1 inline-flex items-center gap-2 border border-cloud/30 px-2.5 py-1 text-xs font-extrabold uppercase tracking-widest text-cloud transition-colors hover:border-royal hover:text-royal"
  aria-label={srLabel}
>
  {
    other === 'en' ? (
      <svg viewBox="0 0 19 12" class="h-3.5 w-5 shrink-0 border border-white/20" aria-hidden="true">
        <rect width="19" height="12" fill="#fff" />
        <g fill="#B22234">
          <rect width="19" height="0.923" y="0" />
          <rect width="19" height="0.923" y="1.846" />
          <rect width="19" height="0.923" y="3.692" />
          <rect width="19" height="0.923" y="5.538" />
          <rect width="19" height="0.923" y="7.385" />
          <rect width="19" height="0.923" y="9.231" />
          <rect width="19" height="0.923" y="11.077" />
        </g>
        <rect width="7.6" height="6.462" fill="#3C3B6E" />
        <g fill="#fff">
          <circle cx="1.2" cy="1.2" r="0.35" />
          <circle cx="2.8" cy="1.2" r="0.35" />
          <circle cx="4.4" cy="1.2" r="0.35" />
          <circle cx="6" cy="1.2" r="0.35" />
          <circle cx="2" cy="2.6" r="0.35" />
          <circle cx="3.6" cy="2.6" r="0.35" />
          <circle cx="5.2" cy="2.6" r="0.35" />
          <circle cx="1.2" cy="4" r="0.35" />
          <circle cx="2.8" cy="4" r="0.35" />
          <circle cx="4.4" cy="4" r="0.35" />
          <circle cx="6" cy="4" r="0.35" />
          <circle cx="2" cy="5.4" r="0.35" />
          <circle cx="3.6" cy="5.4" r="0.35" />
          <circle cx="5.2" cy="5.4" r="0.35" />
        </g>
      </svg>
    ) : (
      <svg viewBox="0 0 19 12" class="h-3.5 w-5 shrink-0 border border-white/20" aria-hidden="true">
        <rect width="19" height="4" fill="#FFCC00" />
        <rect width="19" height="4" y="4" fill="#00247D" />
        <rect width="19" height="4" y="8" fill="#CF142B" />
        <g fill="#fff">
          <circle cx="9.5" cy="4.1" r="0.32" />
          <circle cx="10.9" cy="4.35" r="0.32" />
          <circle cx="11.8" cy="5" r="0.32" />
          <circle cx="12.1" cy="6" r="0.32" />
          <circle cx="11.8" cy="7" r="0.32" />
          <circle cx="10.9" cy="7.65" r="0.32" />
          <circle cx="9.5" cy="7.9" r="0.32" />
          <circle cx="8.1" cy="7.65" r="0.32" />
        </g>
      </svg>
    )
  }
  {label}
</a>

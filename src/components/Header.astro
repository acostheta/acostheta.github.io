---
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-ink text-cloud">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-2 sm:px-6 md:py-3">
    <a href="#main" class="text-lg font-extrabold tracking-tight text-cloud sm:text-xl">
      <span class="text-royal">θ</span> acostheta
    </a>
    <LanguageSwitcher lang={lang} />
  </div>
</header>

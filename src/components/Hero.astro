---
import { t, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<section id="main" class="border-b border-white/10 bg-ink text-white">
  <div
    class="mx-auto flex max-w-5xl flex-col items-center gap-6 px-4 py-12 text-center sm:flex-row sm:px-6 sm:py-14 sm:text-left"
  >
    <img
      src="/img/afoto.jpg"
      alt={t(lang, 'hero.name')}
      width="120"
      height="120"
      class="h-24 w-24 rounded-full border-2 border-white/20 object-cover sm:h-28 sm:w-28"
    />
    <div>
      <h1 class="text-2xl font-extrabold leading-tight tracking-tight sm:text-3xl md:text-4xl">
        {t(lang, 'hero.name')}
      </h1>
      <p class="mt-1 text-lg font-light text-royal sm:text-xl">{t(lang, 'hero.title')}</p>
    </div>
  </div>
</section>

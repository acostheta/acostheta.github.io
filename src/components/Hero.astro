---
import { techStack } from '../data/content';
import { t, type Locale } from '../i18n/ui';
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<section id="main" class="border-b border-white/10 bg-ink text-white">
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-14">
    <div class="grid gap-10 md:grid-cols-5 md:items-stretch md:gap-12">
      <div class="md:col-span-3">
        <div class="flex flex-col items-center gap-5 text-center sm:flex-row sm:items-center sm:text-left">
          <img
            src="/img/afoto.jpg"
            alt={t(lang, 'hero.name')}
            width="120"
            height="120"
            class="h-24 w-24 shrink-0 rounded-full border-2 border-white/20 object-cover sm:h-28 sm:w-28"
          />
          <div>
            <h1 class="text-2xl font-extrabold leading-tight tracking-tight sm:text-3xl">
              {t(lang, 'hero.name')}
            </h1>
            <p class="mt-1 text-lg font-light text-royal sm:text-xl">{t(lang, 'hero.title')}</p>
          </div>
        </div>

        <div class="mt-6 max-w-xl space-y-3 text-[15px] leading-relaxed text-cloud/80">
          <p class="text-base font-medium text-cloud">{t(lang, 'hero.shortBio')}</p>
          <p>{t(lang, 'hero.bio')}</p>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
          <WhatsAppButton lang={lang} />
          <a
            href="#contact"
            class="inline-flex items-center justify-center border border-white/30 px-7 py-3 text-sm font-bold uppercase tracking-widest text-cloud transition-colors hover:border-white hover:bg-white/10"
          >
            {t(lang, 'cta.email')}
          </a>
        </div>
      </div>

      <div class="md:col-span-2 md:flex md:flex-col">
        <dl class="space-y-3 md:flex md:flex-1 md:flex-col md:justify-between md:space-y-0">
          {
            techStack[lang].map((group) => (
              <div>
                <dt class="text-xs font-bold uppercase tracking-wide text-cloud/50">{group.label}</dt>
                <dd class="mt-1.5 flex flex-wrap gap-1.5">
                  {group.items.map((item) => (
                    <span class="border border-white/15 px-2 py-0.5 text-xs font-medium text-cloud/80">
                      {item}
                    </span>
                  ))}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

---
import { services } from '../data/content';
import { t, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const icons: Record<string, string> = {
  mobile:
    '<rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/>',
  qa: '<polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>',
  pm: '<path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="16" x2="14" y2="16"/>',
};
---

<section id="services" class="border-b border-line bg-cloud">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <h2 class="text-3xl font-extrabold text-ink">{t(lang, 'services.title')}</h2>
    <p class="mt-2 text-graphite">{t(lang, 'services.subtitle')}</p>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        services[lang].map((s) => (
          <article class="border border-line bg-white p-6">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-12 w-12 text-royal"
              set:html={icons[s.icon]}
            />
            <h3 class="mt-5 text-xl font-bold text-ink">{s.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-graphite">{s.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

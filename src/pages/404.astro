---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout lang="es" title="404 — No encontrado" description="Página no encontrada">
  <section class="bg-cloud">
    <div class="mx-auto max-w-5xl px-4 py-24 text-center">
      <h1 class="text-6xl font-extrabold text-ink">404</h1>
      <p class="mt-4 text-graphite">Página no encontrada.</p>
      <a href="/es/" class="mt-8 inline-block bg-royal px-6 py-3 font-bold text-white transition-colors hover:bg-royal-dark">
        Volver al inicio
      </a>
    </div>
  </section>
</BaseLayout>
